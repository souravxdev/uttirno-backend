# Copy to .env and adjust for your machine. Never commit .env.
# Values below match docker-compose.yml defaults for local dev.
DATABASE_URL=postgresql://uttirno:uttirno_dev@localhost:5432/uttirno?schema=public
PORT=3000
CORS_ORIGIN=http://localhost:4200

# JWT — generate real secrets (≥16 chars), e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-dev-only
JWT_REFRESH_SECRET=change-me-refresh-secret-dev-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional — AI draft generation (POST /api/admin/import/ai-drafts).
# Leave unset to disable (endpoint returns 503 with a clear message).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
