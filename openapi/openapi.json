{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Service health, version and DB connectivity",
        "tags": [
          "health"
        ]
      }
    },
    "/api/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "Email is already registered"
          }
        },
        "summary": "Register a new learner account",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password"
          }
        },
        "summary": "Log in with email and password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired refresh token"
          }
        },
        "summary": "Exchange a refresh token for a new token pair",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Current authenticated user",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/taxonomy/tree": {
      "get": {
        "operationId": "TaxonomyController_getTree",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExamTreeDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Exam → subject → topic tree with published-question counts",
        "tags": [
          "taxonomy"
        ]
      }
    }
  },
  "info": {
    "title": "Uttirno API",
    "description": "MCQ exam prep platform for BD govt job aspirants. This spec is the single source of truth for frontend API types.",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "example": "ok",
            "description": "'ok' when all dependencies are reachable"
          },
          "version": {
            "type": "string",
            "example": "0.0.1",
            "description": "API version (from package.json)"
          },
          "db": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "example": "up",
            "description": "Database connectivity (SELECT 1 probe)"
          }
        },
        "required": [
          "status",
          "version",
          "db"
        ]
      },
      "RegisterRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "learner@uttirno.test",
            "maxLength": 320
          },
          "password": {
            "type": "string",
            "example": "password123",
            "minLength": 8,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "example": "রাহিম উদ্দিন",
            "maxLength": 120
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "cmrhi7gr200028tuyrux8n0oy"
          },
          "email": {
            "type": "string",
            "example": "learner@uttirno.test"
          },
          "name": {
            "type": "string",
            "example": "রাহিম উদ্দিন",
            "nullable": true
          },
          "role": {
            "type": "string",
            "enum": [
              "LEARNER",
              "ADMIN"
            ],
            "example": "LEARNER"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto"
          },
          "accessToken": {
            "type": "string",
            "description": "Short-lived bearer token"
          },
          "refreshToken": {
            "type": "string",
            "description": "Long-lived token for POST /auth/refresh"
          }
        },
        "required": [
          "user",
          "accessToken",
          "refreshToken"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "learner@uttirno.test"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshRequestDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token from register/login/refresh"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "TopicTreeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "example": "sahitto"
          },
          "name": {
            "type": "string",
            "example": "সাহিত্য"
          },
          "order": {
            "type": "number",
            "example": 1
          },
          "publishedQuestionCount": {
            "type": "number",
            "example": 2,
            "description": "Number of PUBLISHED questions in this topic"
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "order",
          "publishedQuestionCount"
        ]
      },
      "SubjectTreeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "example": "bangla"
          },
          "name": {
            "type": "string",
            "example": "বাংলা"
          },
          "order": {
            "type": "number",
            "example": 1
          },
          "topics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TopicTreeDto"
            }
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "order",
          "topics"
        ]
      },
      "ExamTreeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "example": "bcs-preliminary"
          },
          "name": {
            "type": "string",
            "example": "বিসিএস প্রিলিমিনারি"
          },
          "subjects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubjectTreeDto"
            }
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "subjects"
        ]
      }
    }
  }
}
