{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "HealthController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "Service health, version and DB connectivity",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Uttirno API",
    "description": "MCQ exam prep platform for BD govt job aspirants. This spec is the single source of truth for frontend API types.",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "example": "ok",
            "description": "'ok' when all dependencies are reachable"
          },
          "version": {
            "type": "string",
            "example": "0.0.1",
            "description": "API version (from package.json)"
          },
          "db": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "example": "up",
            "description": "Database connectivity (SELECT 1 probe)"
          }
        },
        "required": [
          "status",
          "version",
          "db"
        ]
      }
    }
  }
}
